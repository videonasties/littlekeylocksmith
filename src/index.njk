---
layout: false
permalink: /
---
<!doctype html>
<html lang="en" data-theme="night" data-business-status="closed" data-open-days="{{ site.openDays }}" data-open-start="{{ site.openStart }}" data-open-end="{{ site.openEnd }}" data-time-zone="{{ site.timeZone }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#17131e">
    <meta name="description" content="{{ site.description }}">
    <title>{{ site.name }}{% if site.tagline %} {{ site.tagline }}{% endif %}</title>
    <link rel="icon" href="favicon.svg" type="image/svg+xml">
    <script src="theme.js"></script>
    <link rel="stylesheet" href="styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap" rel="stylesheet">
  </head>
  <body>
    <a class="skip-link" href="#main">skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href="./" aria-label="{{ site.name }} home">
        <span class="wordmark-icon" aria-hidden="true"><span>♡</span><span class="wordmark-sparkle">✦</span></span>
        <span>{{ site.name }}</span>
      </a>
      <a class="header-link" href="#contact">get in touch <span aria-hidden="true">↗</span></a>
    </header>

    <main id="main">
      <section class="hero wrap">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot"></span> mobile lockout help · holiday hours may vary · {{ site.serviceArea }}</p>
          <h1>locked out?<br><span>let’s get you</span><br>back to <span>your</span> <span class="hero-day">day.</span></h1>
          <p class="hero-intro">reach out to a friendly local locksmith with a decade of experience.</p>
          <div class="hero-actions">
            {% if site.phone %}
              <a class="button button-primary" href="tel:{{ site.phone }}">call {{ site.phoneDisplay or site.phone }} <span aria-hidden="true">↗</span></a>
            {% else %}
              <a class="button button-primary" href="#contact">get in touch <span aria-hidden="true">↗</span></a>
            {% endif %}
            <span class="response-note"><span aria-hidden="true">♡</span> a real person, no judgment.</span>
          </div>
          <div class="hero-footnote"><span aria-hidden="true">♡</span> i can help ou back into your car if you're locked out, or even your apartment probably,, type shit</div>
        </div>

        <div class="hero-art" aria-label="illustration of a little key beside a front door">
          <div class="sunburst" aria-hidden="true"></div>
          <span class="art-heart" aria-hidden="true">♡</span>
          <div class="door-frame" aria-hidden="true">
          <span class="key-sparkle">✦</span>
            <div class="door">
              <div class="door-panel"></div>
              <div class="door-panel"></div>
              <span class="business-sign">we're closed.. srry... check back between 5:30- 8pm monday thru saturday. thx!!! <span aria-hidden="true">♡</span></span>
              <span class="door-knob"></span>
              <span class="door-tag">please let me in.. ;w;</span>
            </div>
          </div>
          <div class="key-illustration" aria-hidden="true">
            <span class="key-head"></span><span class="key-stem"></span><span class="key-tooth key-tooth-one"></span><span class="key-tooth key-tooth-two"></span>
            <span class="key-sparkle">✦</span>
          </div>
        </div>
      </section>

      <section class="service-strip" aria-label="lockout services">
        <p>home <span aria-hidden="true">♡</span> apartment <span aria-hidden="true">♡</span> car lockouts</p>
      </section>

      <section class="how-it-works wrap" id="how-it-works">
        <div class="section-heading">
          <p class="eyebrow">the plan, nice && simple</p>
          <h2>three little steps<br>to a better day.</h2>
        </div>
        <div class="steps">
          <article class="step">
            <span class="step-number">01</span>
            <h3>say hi (rawrr)</h3>
            <p>call or message with where you are and what’s locked. we’ll confirm whether we can help.</p>
          </article>
          <article class="step">
            <span class="step-number">02</span>
            <h3>get the details</h3>
            <p>we’ll talk through availability, an estimated arrival, and the price before we head your way.</p>
          </article>
          <article class="step">
            <span class="step-number">03</span>
            <h3>you can get back in <span class="emoticon">:D</span></h3>
            <p>we’ll verify you’re authorized to access the property or vehicle, then get to work.</p>
          </article>
        </div>
      </section>

      <section class="service-note wrap" aria-label="service details">
        <span class="note-motif" aria-hidden="true">♡</span>
        <p><strong>lockouts are our focus.</strong> need a new lock, key duplication, or something else? we’re not offering those services just yet.</p>
        <span class="note-motif" aria-hidden="true">✦</span>
      </section>

      <section class="contact-section" id="contact">
        <div class="contact-inner wrap">
          <div class="contact-copy">
            <p class="eyebrow">hmmmm.. let’s sort this out</p>
            <h2>your keys are<br>having a day off.</h2>
            <p>tell us where you’re stuck and we’ll let you know if we can come help!!</p>
            {% if site.phone %}
              <a class="button button-light" href="tel:{{ site.phone }}">call {{ site.phoneDisplay or site.phone }} <span aria-hidden="true">↗</span></a>
            {% else %}
              <div class="contact-placeholder"><strong>before you launch:</strong> add your phone number in <code>src/_data/site.json</code> to turn on the call button.</div>
            {% endif %}
          </div>
          <div class="contact-card">
            <p class="card-label">your friendly local locksmith</p>
            <h3>{{ site.name }}</h3>
            <div class="card-line"><span aria-hidden="true">⌖</span><span>{{ site.serviceArea }}</span></div>
            <div class="card-line"><span aria-hidden="true">◷</span><span>{{ site.hours }}</span></div>
            <div class="card-line"><span aria-hidden="true">♡</span><span>home · apartment · car lockouts</span></div>
            <div class="card-line"><span aria-hidden="true">$✦$$$✦</span><span>cashapp: $sagesagesage69 <br />$$$✦venmo: @sage-taylor-202</span></div>
            <p class="fine-print">photo id and proof of authorization are required before service.</p>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer wrap">
      <a class="wordmark" href="./"><span class="wordmark-icon" aria-hidden="true"><span>♡</span><span class="wordmark-sparkle">✦</span></span><span>{{ site.name }}</span></a>
      <p>made with care, && fun && stuff!!</p>
      <a href="#main">back to top ↑</a>
    </footer>
  </body>
</html>
